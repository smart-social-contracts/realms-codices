{
  "id": "dominion",
  "version": "1.0.0",
  "name": "Dominion",
  "description": "A direct democracy with taxation. Citizens propose and vote on decisions collectively.",
  "repository": "https://github.com/smart-social-contracts/realms-codices/tree/main/codices/dominion",
  "kind": "codex",
  "codex_api_version": 2,
  "hooks": [
    "init",
    "on_user_register"
  ],
  "capabilities": [
    "realm_configure",
    "invoice_create",
    "notification_send"
  ],
  "show_in_sidebar": false,
  "currency": {
    "symbol": "DOM",
    "name": "Dominion Token",
    "decimals": 8
  },
  "fees": {
    "registration": 1.0,
    "monthly_membership": 0.5,
    "proposal_submission": 0.1
  },
  "governance": {
    "voting_window_days": 7,
    "quorum_percent": 20,
    "approval_threshold": 0.5,
    "proposal_types": [
      "codex_change",
      "treasury_spend"
    ]
  },
  "billing": {
    "cycle_days": 30,
    "grace_period_days": 7,
    "suspension_after_days": 30
  },
  "membership": {
    "activation_requires": [
      "passport_verified",
      "invoice_paid"
    ],
    "invoice_validity_days": 30
  }
}
