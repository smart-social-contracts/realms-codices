{
  "version": "0.2.0",

  "currency": {
    "symbol": "ckUSDC",
    "name": "ckUSDC",
    "decimals": 6
  },

  "fees": {
    "registration": 1.00,
    "monthly_membership": 0.50,
    "proposal_submission": 0.10
  },

  "governance": {
    "voting_window_days": 7,
    "quorum_percent": 20,
    "approval_threshold": 0.5,
    "proposal_types": [
      "codex_change", "treasury_spend", "welfare_policy",
      "procurement", "elect_enforcer", "remove_enforcer",
      "defense_mission", "defense_policy"
    ]
  },

  "welfare": {
    "percent_of_budget": 30,
    "eligibility_months": 1,
    "distribution_interval_days": 30
  },

  "billing": {
    "cycle_days": 30,
    "grace_period_days": 7,
    "suspension_after_days": 30
  },

  "membership": {
    "activation_requires": ["passport_verified", "invoice_paid"],
    "invoice_validity_days": 30
  },

  "entity_method_overrides": [
    {
      "entity": "User",
      "method": "user_register_posthook",
      "type": "staticmethod",
      "implementation": "Codex.user_registration_hook.user_register_posthook",
      "description": "Custom post-registration hook — creates initial invoices for new users"
    },
    {
      "entity": "Treasury",
      "method": "send",
      "type": "staticmethod",
      "implementation": "Codex.treasury_send_hook.send_hook",
      "description": "Custom send hook for treasuries using vault extension"
    }
  ]
}
