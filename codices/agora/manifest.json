{
  "id": "agora",
  "version": "0.6.0",
  "name": "Agora",
  "dependencies": [
    "access_manager",
    "role_manager",
    "notifications",
    "metrics",
    "land_registry",
    "migration_console"
  ],
  "onboarding": {
    "territory_mode": "incumbent",
    "registration": {
      "open_registration": false,
      "admin_requires_invite": true,
      "member_requires_invite": true,
      "bulk_import": true,
      "programmatic_import": true
    },
    "identity_requirements": []
  },
  "lifecycle": {
    "population_target": 100000,
    "transitions": {
      "alpha_to_beta": {
        "mode": "checklist"
      },
      "beta_to_production": {
        "mode": "admin_approval"
      }
    }
  },
  "fees": {
    "registration": 1.0,
    "monthly_membership": 1.0,
    "proposal_submission": 0.1
  },
  "governance": {
    "voting_window_days": 7,
    "quorum_percent": 20,
    "approval_threshold": 0.5,
    "proposal_types": [
      "codex_change",
      "treasury_spend",
      "welfare_policy",
      "procurement",
      "elect_enforcer",
      "remove_enforcer",
      "defense_mission",
      "defense_policy"
    ]
  },
  "welfare": {
    "percent_of_budget": 30,
    "eligibility_months": 1,
    "distribution_interval_days": 30
  },
  "billing": {
    "cycle_days": 30,
    "grace_period_days": 7,
    "suspension_after_days": 30
  },
  "membership": {
    "activation_requires": [
      "registered"
    ],
    "invoice_validity_days": 30
  },
  "dashboard": {
    "public": {
      "profile": "incumbent_migration",
      "sections": [
        "hero",
        "migration_progress",
        "departments",
        "lifecycle",
        "kpi_strip",
        "zones_map"
      ],
      "hero": {
        "show_join_cta": false
      },
      "migration_progress": {
        "label": "Population migrated",
        "target_field": "lifecycle.population_target"
      }
    }
  },
  "data_files": {
    "departments": "departments.json",
    "justice_license": "justice_license.json",
    "zones": "zones.json"
  },
  "entity_method_overrides": [
    {
      "entity": "User",
      "method": "user_register_posthook",
      "type": "staticmethod",
      "implementation": "Codex.user_registration_hook.user_register_posthook",
      "description": "Incumbent migration onboarding \u2014 no payment during alpha/beta; shows declaration and future tax deadlines"
    },
    {
      "entity": "Treasury",
      "method": "send",
      "type": "staticmethod",
      "implementation": "Codex.treasury_send_hook.send_hook",
      "description": "Custom send hook for treasuries using vault extension"
    }
  ]
}
