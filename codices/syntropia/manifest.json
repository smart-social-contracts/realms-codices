{
  "id": "syntropia",
  "version": "0.8.0",
  "name": "Syntropia",
  "kind": "codex",
  "codex_api_version": 1,
  "show_in_sidebar": false,
  "dependencies": [
    "passport_verification",
    "zone_selector",
    "land_registry",
    "notifications",
    "access_manager",
    "role_manager",
    "procurement"
  ],
  "onboarding": {
    "territory_mode": "greenfield",
    "registration": {
      "open_registration": true,
      "admin_requires_invite": true,
      "member_requires_invite": false,
      "default_profile": "member"
    },
    "identity_requirements": [
      "passport_zk",
      "deposit_paid",
      "kyc_submitted"
    ]
  },
  "parameters": [
    {
      "path": "lifecycle.critical_mass",
      "label": "Critical mass",
      "description": "Citizens required before the realm can advance from alpha to beta.",
      "type": "integer",
      "default": 10000,
      "min": 1
    },
    {
      "path": "lifecycle.beta_proving_days",
      "label": "Beta proving period (days)",
      "description": "Days the realm must spend in beta before going live. Fractions allowed.",
      "type": "number",
      "default": 30,
      "min": 0
    },
    {
      "path": "governance.voting_window_days",
      "label": "Voting window (days)",
      "description": "How long proposals stay open for voting. Fractions allowed (0.0007 \u2248 1 minute).",
      "type": "number",
      "default": 7,
      "min": 0.0001
    },
    {
      "path": "governance.quorum_percent",
      "label": "Quorum (%)",
      "description": "Minimum participation for realm-wide proposals to pass.",
      "type": "integer",
      "default": 20,
      "min": 0,
      "max": 100,
      "advanced": true
    },
    {
      "path": "governance.approval_threshold",
      "label": "Approval threshold",
      "description": "Fraction of decisive votes that must be yes.",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "advanced": true
    },
    {
      "path": "fees.deposit",
      "label": "Citizen deposit",
      "description": "Deposit each joining citizen is invoiced for (realm currency).",
      "type": "number",
      "default": 0.01,
      "min": 0,
      "advanced": true
    },
    {
      "path": "fees.monthly_membership",
      "label": "Monthly membership fee",
      "description": "Tax/membership invoice issued to citizens from beta onward.",
      "type": "number",
      "default": 5e-07,
      "min": 0,
      "advanced": true
    },
    {
      "path": "membership.invoice_validity_days",
      "label": "Invoice validity (days)",
      "type": "number",
      "default": 30,
      "min": 0.0001,
      "advanced": true
    }
  ],
  "lifecycle": {
    "critical_mass": 10000,
    "deposit_amount": 0.01,
    "deposit_label": "a house in a zone",
    "go_live_target": "2027-01-01T00:00:00",
    "beta_proving_days": 30,
    "transitions": {
      "alpha_to_beta": {
        "mode": "auto_milestones",
        "milestones": [
          "critical_mass"
        ]
      },
      "beta_to_production": {
        "mode": "admin_vote"
      }
    }
  },
  "fees": {
    "registration": 1e-06,
    "deposit": 0.01,
    "monthly_membership": 5e-07,
    "proposal_submission": 1e-07
  },
  "governance": {
    "voting_window_days": 7,
    "quorum_percent": 20,
    "approval_threshold": 0.5,
    "member_voting_enabled_stage": "production",
    "proposal_types": [
      "codex_change",
      "treasury_spend"
    ]
  },
  "billing": {
    "cycle_days": 30,
    "grace_period_days": 7,
    "suspension_after_days": 30
  },
  "membership": {
    "activation_requires": [
      "passport_verified",
      "deposit_paid",
      "kyc_submitted"
    ],
    "invoice_validity_days": 30
  },
  "dashboard": {
    "public": {
      "profile": "greenfield_smart_city",
      "sections": [
        "hero",
        "countdown",
        "citizen_counter",
        "threshold",
        "lifecycle",
        "zones_map"
      ],
      "hero": {
        "show_join_cta": true,
        "join_label": "Become a citizen"
      },
      "countdown": {
        "label": "Time to go-live",
        "target_field": "lifecycle.go_live_target"
      },
      "citizen_counter": {
        "label": "Citizens onboarded"
      },
      "threshold": {
        "label": "Critical mass",
        "target_field": "lifecycle.critical_mass"
      }
    }
  },
  "data_files": {
    "departments": "data/departments.json",
    "justice_license": "data/justice_license.json",
    "zones": "data/zones.json"
  }
}