        {
          "title": "speaker",
          "profile": "speaker",
          "headcount": 1,
          "salary_amount": 5000,
          "inherit_from_capital": true
        },
        {
          "title": "congress_member",
          "profile": "congress_member",
          "headcount": 5,
          "salary_amount": 4000,
          "inherit_from_capital": true
        }
