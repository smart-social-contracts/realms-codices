{
  "id": "agora",
  "version": "1.0.0",
  "name": "Agora",
  "description": "A migration codex for an existing public administration moving its entire IT to Realms GOS (a 1-to-1 migration). The population already exists, so onboarding is by registration code or bulk/programmatic import — no ZK passport.",
  "repository": "https://github.com/smart-social-contracts/realms-codices/tree/main/codices/agora",
  "kind": "codex",
  "codex_api_version": 2,
  "hooks": [
    "init",
    "on_user_register",
    "on_stage_change"
  ],
  "capabilities": [
    "user_list",
    "department_list",
    "realm_configure",
    "department_create",
    "department_set_policy",
    "fund_create",
    "profile_create",
    "position_create",
    "court_create",
    "invoice_create",
    "notification_send",
    "payroll_run"
  ],
  "show_in_sidebar": false,
  "dependencies": [
    "access_manager",
    "department_docs",
    "justice_litigation",
    "land_registry",
    "managed_services",
    "member_manager",
    "metrics",
    "notifications",
    "package_manager",
    "procurement",
    "role_manager",
    "system_info",
    "task_monitor",
    "zone_selector"
  ],
  "onboarding": {
    "territory_mode": "incumbent",
    "registration": {
      "open_registration": false,
      "admin_requires_invite": true,
      "member_requires_invite": true,
      "bulk_import": true,
      "programmatic_import": true
    },
    "identity_requirements": []
  },
  "parameters": [
    {
      "path": "lifecycle.population_target",
      "label": "Population target",
      "description": "Citizens to import before the migration checklist allows beta.",
      "type": "integer",
      "default": 100000,
      "min": 1
    },
    {
      "path": "lifecycle.beta_proving_days",
      "label": "Beta proving period (days)",
      "description": "Days the realm must spend in beta before going live. Fractions allowed.",
      "type": "number",
      "default": 30,
      "min": 0
    },
    {
      "path": "governance.voting_window_days",
      "label": "Voting window (days)",
      "description": "How long proposals stay open for voting. Fractions allowed (0.0007 ≈ 1 minute).",
      "type": "number",
      "default": 7,
      "min": 0.0001
    },
    {
      "path": "governance.quorum_percent",
      "label": "Quorum (%)",
      "description": "Minimum participation for realm-wide proposals to pass.",
      "type": "integer",
      "default": 20,
      "min": 0,
      "max": 100,
      "advanced": true
    },
    {
      "path": "governance.approval_threshold",
      "label": "Approval threshold",
      "description": "Fraction of decisive votes that must be yes.",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "advanced": true
    },
    {
      "path": "fees.registration",
      "label": "Registration fee",
      "type": "number",
      "default": 1.0,
      "min": 0,
      "advanced": true
    },
    {
      "path": "fees.monthly_membership",
      "label": "Monthly membership fee",
      "type": "number",
      "default": 1.0,
      "min": 0,
      "advanced": true
    },
    {
      "path": "billing.cycle_days",
      "label": "Billing cycle (days)",
      "type": "number",
      "default": 30,
      "min": 0.0001,
      "advanced": true
    }
  ],
  "lifecycle": {
    "population_target": 100000,
    "beta_proving_days": 30,
    "transitions": {
      "alpha_to_beta": {
        "mode": "checklist"
      },
      "beta_to_production": {
        "mode": "admin_approval"
      }
    }
  },
  "fees": {
    "registration": 1.0,
    "monthly_membership": 1.0,
    "proposal_submission": 0.1
  },
  "governance": {
    "voting_window_days": 7,
    "quorum_percent": 20,
    "approval_threshold": 0.5,
    "proposal_types": [
      "codex_change",
      "treasury_spend",
      "welfare_policy",
      "procurement",
      "elect_enforcer",
      "remove_enforcer",
      "defense_mission",
      "defense_policy"
    ]
  },
  "welfare": {
    "percent_of_budget": 30,
    "eligibility_months": 1,
    "distribution_interval_days": 30
  },
  "billing": {
    "cycle_days": 30,
    "grace_period_days": 7,
    "suspension_after_days": 30
  },
  "membership": {
    "activation_requires": [
      "registered"
    ],
    "invoice_validity_days": 30
  },
  "dashboard": {
    "public": {
      "profile": "incumbent_migration",
      "sections": [
        "hero",
        "migration_progress",
        "departments",
        "lifecycle",
        "kpi_strip",
        "zones_map"
      ],
      "hero": {
        "show_join_cta": false
      },
      "migration_progress": {
        "label": "Population migrated",
        "target_field": "lifecycle.population_target"
      }
    }
  },
  "seed": {
    "departments": [
      {
        "name": "Congress",
        "description": "Supreme legislative authority. Receives root from the creator at the Beta transition and holds all realm permissions from then on; decides the move to Live by vote.",
        "fund": "DEPT-CONGRESS",
        "permissions": [
          "governance.update",
          "proposal.create",
          "proposal.manage",
          "org.appoint",
          "org.set_policy",
          "codex.revert",
          "realm.configure"
        ],
        "positions": [
          {
            "title": "speaker",
            "headcount": 1,
            "salary": 5000
          },
          {
            "title": "congress_member",
            "headcount": 5,
            "salary": 4000
          }
        ]
      },
      {
        "name": "Civil Registry",
        "description": "Population register, identity records, and migration of existing citizens into the realm.",
        "fund": "DEPT-CIVREG",
        "permissions": [
          "user.add",
          "user.view",
          "user.edit",
          "invite.manage"
        ],
        "positions": [
          {
            "title": "registrar",
            "headcount": 2,
            "salary": 3000
          },
          {
            "title": "clerk",
            "headcount": 5,
            "salary": 2200
          }
        ]
      },
      {
        "name": "Justice",
        "description": "Courts, dispute resolution, and enforcement oversight.",
        "fund": "DEPT-JUST",
        "permissions": [
          "dispute.view_all",
          "dispute.assign",
          "resolution.draft",
          "resolution.issue"
        ],
        "positions": [
          {
            "title": "judge",
            "headcount": 2,
            "salary": 5000
          },
          {
            "title": "court_clerk",
            "headcount": 3,
            "salary": 2500
          }
        ]
      },
      {
        "name": "Defense",
        "description": "Civil protection, emergency response, and public security.",
        "fund": "DEPT-DEF",
        "permissions": [
          "enforcement.record",
          "enforcement.escalate"
        ],
        "positions": [
          {
            "title": "defense_director",
            "headcount": 1,
            "salary": 4500
          },
          {
            "title": "security_officer",
            "headcount": 4,
            "salary": 2800
          }
        ]
      },
      {
        "name": "Social Security",
        "description": "Welfare benefits, pensions, social support, and redistribution programs.",
        "fund": "DEPT-SOC",
        "permissions": [
          "treasury.view",
          "transfer.create"
        ],
        "positions": [
          {
            "title": "benefits_officer",
            "headcount": 3,
            "salary": 2800
          },
          {
            "title": "social_worker",
            "headcount": 5,
            "salary": 2500
          }
        ]
      },
      {
        "name": "Infrastructure",
        "description": "Land zones, public works, and the geographic organization of quarters.",
        "fund": "DEPT-INFRA",
        "permissions": [
          "nft.mint",
          "tender.manage"
        ],
        "positions": [
          {
            "title": "land_officer",
            "headcount": 2,
            "salary": 3000
          },
          {
            "title": "engineer",
            "headcount": 4,
            "salary": 3000
          },
          {
            "title": "operator",
            "headcount": 4,
            "salary": 2200
          }
        ]
      },
      {
        "name": "Economy",
        "description": "Public finances, treasury, budgets, and (future) tax declarations and collection.",
        "fund": "DEPT-ECON",
        "policy": {
          "m": 2,
          "n": 3
        },
        "permissions": [
          "treasury.view",
          "treasury.manage",
          "transfer.create",
          "tax.assess",
          "org.manage_budget"
        ],
        "positions": [
          {
            "title": "treasurer",
            "headcount": 1,
            "salary": 4500
          },
          {
            "title": "tax_officer",
            "headcount": 4,
            "salary": 2800
          }
        ]
      },
      {
        "name": "Administration",
        "description": "Realm operations, role management, and lifecycle administration.",
        "fund": "DEPT-ADMIN",
        "permissions": [
          "role.assign",
          "role.revoke",
          "realm.configure",
          "extension.install"
        ],
        "positions": [
          {
            "title": "admin",
            "headcount": 2,
            "salary": 4000
          }
        ]
      }
    ],
    "justice": {
      "department": "Justice",
      "courts": [
        {
          "name": "Supreme Court",
          "level": "supreme",
          "jurisdiction": "Realm-wide",
          "scope": "capital"
        },
        {
          "name": "Court of Appeals",
          "level": "appellate",
          "jurisdiction": "Realm-wide — Appeals",
          "scope": "capital",
          "parent": "Supreme Court"
        },
        {
          "name": "District Court",
          "level": "first_instance",
          "jurisdiction": "General",
          "scope": "quarter",
          "parent": "Court of Appeals"
        }
      ]
    }
  }
}
