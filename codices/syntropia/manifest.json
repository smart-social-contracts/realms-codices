{
  "id": "syntropia",
  "version": "1.0.0",
  "name": "Syntropia",
  "description": "A greenfield codex for a brand-new sovereign smart city built from scratch. Because there is no existing population, new citizens onboard with a ZK passport, pay a deposit — a house in a zone — and submit Know-Your-Citizen data before the city goes live.",
  "repository": "https://github.com/smart-social-contracts/realms-codices/tree/main/codices/syntropia",
  "kind": "codex",
  "codex_api_version": 2,
  "hooks": [
    "init",
    "on_user_register",
    "on_stage_change",
    "assign_quarter"
  ],
  "capabilities": [
    "user_list",
    "department_list",
    "realm_configure",
    "department_create",
    "department_set_policy",
    "fund_create",
    "profile_create",
    "position_create",
    "court_create",
    "invoice_create",
    "notification_send",
    "payroll_run"
  ],
  "show_in_sidebar": false,
  "dependencies": [
    "access_manager",
    "department_docs",
    "justice_litigation",
    "land_registry",
    "managed_services",
    "member_manager",
    "metrics",
    "notifications",
    "package_manager",
    "passport_verification",
    "procurement",
    "role_manager",
    "system_info",
    "task_monitor",
    "zone_selector"
  ],
  "onboarding": {
    "territory_mode": "greenfield",
    "registration": {
      "open_registration": true,
      "admin_requires_invite": true,
      "member_requires_invite": false,
      "default_profile": "member"
    },
    "identity_requirements": [
      "passport_zk",
      "deposit_paid",
      "kyc_submitted"
    ]
  },
  "parameters": [
    {
      "path": "lifecycle.critical_mass",
      "label": "Critical mass",
      "description": "Citizens required before the realm can advance from alpha to beta.",
      "type": "integer",
      "default": 10000,
      "min": 1
    },
    {
      "path": "lifecycle.beta_proving_days",
      "label": "Beta proving period (days)",
      "description": "Days the realm must spend in beta before going live. Fractions allowed.",
      "type": "number",
      "default": 30,
      "min": 0
    },
    {
      "path": "governance.voting_window_days",
      "label": "Voting window (days)",
      "description": "How long proposals stay open for voting. Fractions allowed (0.0007 ≈ 1 minute).",
      "type": "number",
      "default": 7,
      "min": 0.0001
    },
    {
      "path": "governance.quorum_percent",
      "label": "Quorum (%)",
      "description": "Minimum participation for realm-wide proposals to pass.",
      "type": "integer",
      "default": 20,
      "min": 0,
      "max": 100,
      "advanced": true
    },
    {
      "path": "governance.approval_threshold",
      "label": "Approval threshold",
      "description": "Fraction of decisive votes that must be yes.",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "advanced": true
    },
    {
      "path": "fees.deposit",
      "label": "Citizen deposit",
      "description": "Deposit each joining citizen is invoiced for (realm currency).",
      "type": "number",
      "default": 0.01,
      "min": 0,
      "advanced": true
    },
    {
      "path": "fees.monthly_membership",
      "label": "Monthly membership fee",
      "description": "Tax/membership invoice issued to citizens from beta onward.",
      "type": "number",
      "default": 5e-07,
      "min": 0,
      "advanced": true
    },
    {
      "path": "membership.invoice_validity_days",
      "label": "Invoice validity (days)",
      "type": "number",
      "default": 30,
      "min": 0.0001,
      "advanced": true
    }
  ],
  "lifecycle": {
    "critical_mass": 10000,
    "deposit_amount": 0.01,
    "deposit_label": "a house in a zone",
    "go_live_target": "2027-01-01T00:00:00",
    "beta_proving_days": 30,
    "transitions": {
      "alpha_to_beta": {
        "mode": "auto_milestones",
        "milestones": [
          "critical_mass"
        ]
      },
      "beta_to_production": {
        "mode": "admin_vote"
      }
    }
  },
  "fees": {
    "registration": 1e-06,
    "deposit": 0.01,
    "monthly_membership": 5e-07,
    "proposal_submission": 1e-07
  },
  "governance": {
    "voting_window_days": 7,
    "quorum_percent": 20,
    "approval_threshold": 0.5,
    "member_voting_enabled_stage": "production",
    "proposal_types": [
      "codex_change",
      "treasury_spend"
    ]
  },
  "billing": {
    "cycle_days": 30,
    "grace_period_days": 7,
    "suspension_after_days": 30
  },
  "membership": {
    "activation_requires": [
      "passport_verified",
      "deposit_paid",
      "kyc_submitted"
    ],
    "invoice_validity_days": 30
  },
  "dashboard": {
    "public": {
      "profile": "greenfield_smart_city",
      "sections": [
        "hero",
        "countdown",
        "citizen_counter",
        "threshold",
        "lifecycle",
        "zones_map"
      ],
      "hero": {
        "show_join_cta": true,
        "join_label": "Become a citizen"
      },
      "countdown": {
        "label": "Time to go-live",
        "target_field": "lifecycle.go_live_target"
      },
      "citizen_counter": {
        "label": "Citizens onboarded"
      },
      "threshold": {
        "label": "Critical mass",
        "target_field": "lifecycle.critical_mass"
      }
    }
  },
  "quarter": {
    "max_population": 0
  },
  "seed": {
    "departments": [
      {
        "name": "Congress",
        "description": "Supreme legislative authority. Receives root from the creator at the Beta transition and holds all realm permissions from then on; decides the move to Live by vote.",
        "fund": "DEPT-CONGRESS",
        "permissions": [
          "governance.update",
          "proposal.create",
          "proposal.manage",
          "org.appoint",
          "org.set_policy",
          "codex.revert",
          "realm.configure"
        ],
        "positions": [
          {
            "title": "speaker",
            "headcount": 1,
            "salary": 5000
          },
          {
            "title": "congress_member",
            "headcount": 5,
            "salary": 4000
          }
        ]
      },
      {
        "name": "Citizenship & Identity",
        "description": "ZK passport onboarding, Know-Your-Citizen review, and deposit verification.",
        "fund": "DEPT-CITIZEN",
        "permissions": [
          "user.view",
          "user.edit",
          "identity.review"
        ],
        "positions": [
          {
            "title": "registrar",
            "headcount": 2,
            "salary": 3000
          },
          {
            "title": "kyc_officer",
            "headcount": 3,
            "salary": 2500
          }
        ]
      },
      {
        "name": "Justice",
        "description": "Constitutional court and dispute resolution.",
        "fund": "DEPT-JUST",
        "permissions": [
          "dispute.view_all",
          "dispute.assign",
          "resolution.draft",
          "resolution.issue"
        ],
        "positions": [
          {
            "title": "judge",
            "headcount": 2,
            "salary": 5000
          },
          {
            "title": "court_clerk",
            "headcount": 3,
            "salary": 2500
          }
        ]
      },
      {
        "name": "Defense",
        "description": "Civil protection, emergency response, and security of the city.",
        "fund": "DEPT-DEF",
        "permissions": [
          "enforcement.record",
          "enforcement.escalate"
        ],
        "positions": [
          {
            "title": "defense_director",
            "headcount": 1,
            "salary": 4500
          },
          {
            "title": "security_officer",
            "headcount": 4,
            "salary": 2800
          }
        ]
      },
      {
        "name": "Social Security",
        "description": "Welfare benefits, social support, and redistribution programs.",
        "fund": "DEPT-SOC",
        "permissions": [
          "treasury.view",
          "transfer.create"
        ],
        "positions": [
          {
            "title": "benefits_officer",
            "headcount": 2,
            "salary": 2800
          },
          {
            "title": "social_worker",
            "headcount": 4,
            "salary": 2500
          }
        ]
      },
      {
        "name": "Infrastructure",
        "description": "Zones, housing allocation, public works, and quarter planning as the city grows.",
        "fund": "DEPT-INFRA",
        "permissions": [
          "nft.mint",
          "tender.manage"
        ],
        "positions": [
          {
            "title": "land_officer",
            "headcount": 2,
            "salary": 3000
          },
          {
            "title": "planner",
            "headcount": 2,
            "salary": 3200
          },
          {
            "title": "engineer",
            "headcount": 3,
            "salary": 3000
          }
        ]
      },
      {
        "name": "Economy",
        "description": "Deposits (a house in a zone), treasury, budgets, and realm finances.",
        "fund": "DEPT-ECON",
        "permissions": [
          "treasury.view",
          "treasury.manage",
          "transfer.create",
          "tax.assess",
          "org.manage_budget"
        ],
        "positions": [
          {
            "title": "treasurer",
            "headcount": 1,
            "salary": 4500
          },
          {
            "title": "finance_officer",
            "headcount": 3,
            "salary": 2800
          }
        ]
      },
      {
        "name": "Administration",
        "description": "Founders and admins — the only actors who can make fundamental changes before go-live.",
        "fund": "DEPT-ADMIN",
        "permissions": [
          "role.assign",
          "role.revoke",
          "realm.configure",
          "extension.install"
        ],
        "positions": [
          {
            "title": "admin",
            "headcount": 2,
            "salary": 4000
          }
        ]
      }
    ],
    "justice": {
      "department": "Justice",
      "courts": [
        {
          "name": "Constitutional Court",
          "level": "supreme",
          "jurisdiction": "City-wide",
          "scope": "capital"
        },
        {
          "name": "Community Court",
          "level": "first_instance",
          "jurisdiction": "General",
          "scope": "quarter",
          "parent": "Constitutional Court"
        }
      ]
    }
  }
}
